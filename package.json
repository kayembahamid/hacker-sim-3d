{
  "name": "hacker-sim-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hacker’s Notes 3D: Night Shift at Veltrix. A browser 3D security simulation for office workers, played at hacker.hamcodes.com/sim/.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4174",
    "test": "playwright test",
    "perf": "node dev/perf.mjs http://127.0.0.1:4174/sim/",
    "check:domains": "node tools/check-domains.mjs content/office",
    "fetch": "node tools/fetch-sources.mjs",
    "art": "node tools/art.mjs",
    "ktx": "node tools/get-ktx.mjs",
    "bake:preview": "${BLENDER:-blender} --background --factory-startup --python tools/blender/run.py -- --scene office --mode preview --out tools/.cache/bake --samples 48 --res 1440x900",
    "bake": "${BLENDER:-blender} --background --factory-startup --python tools/blender/run.py -- --scene office --mode bake --out tools/.cache/bake --samples 256",
    "optimize": "node tools/optimize-room.mjs tools/.cache/bake/office.glb public/assets/room/office.glb --tex etc1s",
    "credits": "node tools/credits.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "1.63.0",
    "meshoptimizer": "^0.22.0",
    "sharp": "^0.35.4",
    "vite": "6.4.3"
  }
}
